rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Reusable Hardened Global Primitives
    // =========================================================================

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          request.auth.token.email == 'alnwmbshyr1@gmail.com'
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isBoundedString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidRoleId(r) {
      return r in ['owner', 'accountant', 'cashier', 'salesman', 'warehouse'];
    }

    function isValidPaymentMethod(pm) {
      return pm in ['cash', 'credit', 'pos_card', 'transfer', 'cheque', 'installment'];
    }

    function hasValidTimestampsCreate(data) {
      return data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function hasValidTimestampsUpdate() {
      return incoming().createdAt is timestamp &&
        incoming().updatedAt is timestamp &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
    }

    function isValidRoleList(arr) {
      return arr is list &&
        arr.size() <= 40 &&
        (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 40));
    }

    function isValidPermissionsMatrix(m) {
      return m is map &&
        m.keys().hasAll(['owner', 'accountant', 'salesman', 'warehouse']) &&
        m.keys().hasOnly(['owner', 'accountant', 'cashier', 'salesman', 'warehouse']) &&
        isValidRoleList(m.owner) &&
        isValidRoleList(m.accountant) &&
        (!('cashier' in m) || isValidRoleList(m.cashier)) &&
        isValidRoleList(m.salesman) &&
        isValidRoleList(m.warehouse);
    }

    function isValidLineItems(items, minLen, maxLen) {
      return items is list &&
        items.size() >= minLen &&
        items.size() <= maxLen && (
          items.size() == 0 || (
            items[0] is map &&
            items[0].keys().hasAll(['productId', 'productName', 'qty', 'unitPrice', 'total']) &&
            items[0].keys().hasOnly([
              'productId', 'productName', 'qty', 'unitPrice', 'total',
              'barcode', 'imageBase64', 'category', 'unit', 'costPrice',
              'wholesalePrice', 'discountPercent', 'discountAmount', 'taxRate',
              'taxAmount', 'expiryDate', 'note'
            ]) &&
            isBoundedString(items[0].productId, 128) &&
            isNonEmptyString(items[0].productName, 160) &&
            items[0].qty is number && items[0].qty >= 0 &&
            items[0].unitPrice is number && items[0].unitPrice >= 0 &&
            items[0].total is number && items[0].total >= 0 &&
            (!('barcode' in items[0]) || isBoundedString(items[0].barcode, 64)) &&
            (!('imageBase64' in items[0]) || isBoundedString(items[0].imageBase64, 250000)) &&
            (!('category' in items[0]) || isBoundedString(items[0].category, 80)) &&
            (!('unit' in items[0]) || items[0].unit in ['piece', 'carton', 'kg', 'meter']) &&
            (!('costPrice' in items[0]) || (items[0].costPrice is number && items[0].costPrice >= 0)) &&
            (!('wholesalePrice' in items[0]) || (items[0].wholesalePrice is number && items[0].wholesalePrice >= 0)) &&
            (!('discountPercent' in items[0]) || (items[0].discountPercent is number && items[0].discountPercent >= 0 && items[0].discountPercent <= 100)) &&
            (!('discountAmount' in items[0]) || (items[0].discountAmount is number && items[0].discountAmount >= 0)) &&
            (!('taxRate' in items[0]) || (items[0].taxRate is number && items[0].taxRate >= 0 && items[0].taxRate <= 100)) &&
            (!('taxAmount' in items[0]) || (items[0].taxAmount is number && items[0].taxAmount >= 0)) &&
            (!('expiryDate' in items[0]) || isBoundedString(items[0].expiryDate, 32)) &&
            (!('note' in items[0]) || isBoundedString(items[0].note, 200))
          )
        );
    }

    function isValidJournalLines(lines) {
      return lines is list &&
        lines.size() >= 1 &&
        lines.size() <= 50 &&
        lines[0] is map &&
        lines[0].keys().hasAll(['account', 'debit', 'credit']) &&
        lines[0].keys().hasOnly(['account', 'debit', 'credit']) &&
        isNonEmptyString(lines[0].account, 160) &&
        lines[0].debit is number && lines[0].debit >= 0 &&
        lines[0].credit is number && lines[0].credit >= 0;
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        (data.uid == userId) &&
        (data.uid == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.email, 256) &&
        isNonEmptyString(data.displayName, 120) &&
        (!('photoUrl' in data) || isBoundedString(data.photoUrl, 512)) &&
        data.role in ['user', 'admin'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCurrencyCode(code) {
      return code in ['SAR', 'YER', 'EGP', 'AED', 'USD', 'EUR', 'GBP', 'KWD', 'QAR', 'BHD', 'OMR', 'JOD', 'TRY'];
    }

    function isValidCurrencyList(arr) {
      return arr is list &&
        arr.size() >= 1 &&
        arr.size() <= 15 &&
        arr[0] is string &&
        isValidCurrencyCode(arr[0]);
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll([
          'ownerId', 'companyName', 'taxNumber', 'crNumber', 'phone', 'email', 'address',
          'currency', 'isArabic', 'isDarkMode', 'monthlySalesGoal', 'defaultSalesTaxRate',
          'defaultPurchaseTaxRate', 'autoBackupDaily', 'activePlan', 'trialStartIso',
          'currentRole', 'permissionsMatrix', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'companyName', 'taxNumber', 'crNumber', 'phone', 'email', 'address',
          'currency', 'enabledCurrencies', 'exchangeRates', 'lastRatesUpdate',
          'isArabic', 'isDarkMode', 'monthlySalesGoal', 'defaultSalesTaxRate',
          'defaultPurchaseTaxRate', 'autoBackupDaily', 'lastBackupDate',
          'autoCloudSync', 'autoSyncIntervalMinutes', 'logoBase64', 'fiscalLockDate',
          'defaultBranchId', 'defaultWarehouseId', 'receiptFooter', 'activePlan',
          'trialStartIso', 'currentRole', 'permissionsMatrix', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.companyName, 160) &&
        isBoundedString(data.taxNumber, 64) &&
        isBoundedString(data.crNumber, 64) &&
        isBoundedString(data.phone, 40) &&
        isBoundedString(data.email, 160) &&
        isBoundedString(data.address, 300) &&
        isValidCurrencyCode(data.currency) &&
        (!('enabledCurrencies' in data) || isValidCurrencyList(data.enabledCurrencies)) &&
        (!('exchangeRates' in data) || (data.exchangeRates is map && data.exchangeRates.size() <= 20)) &&
        (!('lastRatesUpdate' in data) || isBoundedString(data.lastRatesUpdate, 64)) &&
        data.isArabic is bool &&
        data.isDarkMode is bool &&
        data.monthlySalesGoal is number && data.monthlySalesGoal >= 0 &&
        data.defaultSalesTaxRate is number && data.defaultSalesTaxRate >= 0 && data.defaultSalesTaxRate <= 100 &&
        data.defaultPurchaseTaxRate is number && data.defaultPurchaseTaxRate >= 0 && data.defaultPurchaseTaxRate <= 100 &&
        data.autoBackupDaily is bool &&
        (!('lastBackupDate' in data) || isBoundedString(data.lastBackupDate, 64)) &&
        (!('autoCloudSync' in data) || data.autoCloudSync is bool) &&
        (!('autoSyncIntervalMinutes' in data) || (data.autoSyncIntervalMinutes is number && data.autoSyncIntervalMinutes >= 0 && data.autoSyncIntervalMinutes <= 1440)) &&
        (!('logoBase64' in data) || isBoundedString(data.logoBase64, 250000)) &&
        (!('fiscalLockDate' in data) || isBoundedString(data.fiscalLockDate, 32)) &&
        (!('defaultBranchId' in data) || isBoundedString(data.defaultBranchId, 128)) &&
        (!('defaultWarehouseId' in data) || isBoundedString(data.defaultWarehouseId, 128)) &&
        (!('receiptFooter' in data) || isBoundedString(data.receiptFooter, 300)) &&
        isNonEmptyString(data.activePlan, 40) &&
        isNonEmptyString(data.trialStartIso, 64) &&
        isValidRoleId(data.currentRole) &&
        isValidPermissionsMatrix(data.permissionsMatrix) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'customerId', 'customerName', 'customerPhone', 'description',
          'items', 'subtotal', 'taxRate', 'vat', 'total', 'status', 'date', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'customerId', 'customerName', 'customerPhone', 'description',
          'items', 'subtotal', 'taxRate', 'vat', 'total', 'currency', 'exchangeRate', 'baseTotal',
          'status', 'date', 'invoiceType', 'dueDate', 'branchId', 'branchName', 'warehouseId',
          'warehouseName', 'salespersonName', 'shiftName', 'paymentMethod', 'discountTotal',
          'shippingFee', 'extraFee', 'paidAmount', 'remainingAmount', 'notes', 'terms',
          'sellerSignature', 'customerSignature', 'installments', 'createdByRole',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isBoundedString(data.customerId, 128) &&
        isNonEmptyString(data.customerName, 160) &&
        isBoundedString(data.customerPhone, 40) &&
        isBoundedString(data.description, 500) &&
        isValidLineItems(data.items, 0, 50) &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100 &&
        data.vat is number && data.vat >= 0 &&
        data.total is number && data.total >= 0 &&
        (!('currency' in data) || isValidCurrencyCode(data.currency)) &&
        (!('exchangeRate' in data) || (data.exchangeRate is number && data.exchangeRate > 0)) &&
        (!('baseTotal' in data) || (data.baseTotal is number && data.baseTotal >= 0)) &&
        data.status in ['paid', 'partial', 'pending', 'overdue', 'cancelled'] &&
        isNonEmptyString(data.date, 64) &&
        (!('invoiceType' in data) || data.invoiceType in ['sales', 'return', 'quotation']) &&
        (!('dueDate' in data) || isBoundedString(data.dueDate, 64)) &&
        (!('branchId' in data) || isBoundedString(data.branchId, 128)) &&
        (!('branchName' in data) || isBoundedString(data.branchName, 120)) &&
        (!('warehouseId' in data) || isBoundedString(data.warehouseId, 128)) &&
        (!('warehouseName' in data) || isBoundedString(data.warehouseName, 120)) &&
        (!('salespersonName' in data) || isBoundedString(data.salespersonName, 120)) &&
        (!('shiftName' in data) || isBoundedString(data.shiftName, 80)) &&
        (!('paymentMethod' in data) || isValidPaymentMethod(data.paymentMethod)) &&
        (!('discountTotal' in data) || (data.discountTotal is number && data.discountTotal >= 0)) &&
        (!('shippingFee' in data) || (data.shippingFee is number && data.shippingFee >= 0)) &&
        (!('extraFee' in data) || (data.extraFee is number && data.extraFee >= 0)) &&
        (!('paidAmount' in data) || (data.paidAmount is number && data.paidAmount >= 0)) &&
        (!('remainingAmount' in data) || (data.remainingAmount is number && data.remainingAmount >= 0)) &&
        (!('notes' in data) || isBoundedString(data.notes, 500)) &&
        (!('terms' in data) || isBoundedString(data.terms, 500)) &&
        (!('sellerSignature' in data) || isBoundedString(data.sellerSignature, 160)) &&
        (!('customerSignature' in data) || isBoundedString(data.customerSignature, 160)) &&
        (!('installments' in data) || (data.installments is list && data.installments.size() <= 36)) &&
        (!('createdByRole' in data) || isValidRoleId(data.createdByRole)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReturnRecord(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'type', 'originalDocId', 'partyName', 'partyPhone',
          'productId', 'productName', 'qty', 'unitPrice', 'amount', 'reason', 'notes',
          'date', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'type', 'originalDocId', 'partyName', 'partyPhone',
          'productId', 'productName', 'qty', 'unitPrice', 'amount', 'reason', 'notes',
          'date', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        data.type in ['sales', 'purchase'] &&
        isBoundedString(data.originalDocId, 128) &&
        isNonEmptyString(data.partyName, 160) &&
        isBoundedString(data.partyPhone, 40) &&
        isBoundedString(data.productId, 128) &&
        isNonEmptyString(data.productName, 160) &&
        data.qty is number && data.qty >= 0 &&
        data.unitPrice is number && data.unitPrice >= 0 &&
        data.amount is number && data.amount >= 0 &&
        data.reason in ['damaged', 'wrong_item', 'expired', 'changed_mind', 'other'] &&
        isBoundedString(data.notes, 500) &&
        isNonEmptyString(data.date, 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQuotation(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'customerId', 'customerName', 'customerPhone', 'customerEmail',
          'items', 'discountPercent', 'subtotal', 'discountAmount', 'vat', 'total',
          'validUntil', 'status', 'notes', 'date', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'customerId', 'customerName', 'customerPhone', 'customerEmail',
          'items', 'discountPercent', 'subtotal', 'discountAmount', 'vat', 'total',
          'validUntil', 'status', 'notes', 'date', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isBoundedString(data.customerId, 128) &&
        isNonEmptyString(data.customerName, 160) &&
        isBoundedString(data.customerPhone, 40) &&
        isBoundedString(data.customerEmail, 160) &&
        isValidLineItems(data.items, 1, 50) &&
        data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100 &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.discountAmount is number && data.discountAmount >= 0 &&
        data.vat is number && data.vat >= 0 &&
        data.total is number && data.total >= 0 &&
        isBoundedString(data.validUntil, 64) &&
        data.status in ['draft', 'sent', 'accepted', 'rejected', 'expired'] &&
        isBoundedString(data.notes, 500) &&
        isNonEmptyString(data.date, 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'phone', 'email', 'debt', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'name', 'phone', 'email', 'debt', 'creditLimit',
          'code', 'companyName', 'photoBase64', 'whatsapp', 'address', 'city', 'country',
          'mapUrl', 'customerType', 'taxNumber', 'nationalId', 'birthDate', 'creditTermDays',
          'preferredPaymentMethod', 'salesRep', 'branchId', 'status', 'notes', 'callLogs',
          'createdAtDate', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.name, 160) &&
        isBoundedString(data.phone, 40) &&
        isBoundedString(data.email, 160) &&
        data.debt is number && data.debt >= 0 &&
        (!('creditLimit' in data) || (data.creditLimit is number && data.creditLimit >= 0)) &&
        (!('code' in data) || isBoundedString(data.code, 64)) &&
        (!('companyName' in data) || isBoundedString(data.companyName, 160)) &&
        (!('photoBase64' in data) || isBoundedString(data.photoBase64, 250000)) &&
        (!('whatsapp' in data) || isBoundedString(data.whatsapp, 40)) &&
        (!('address' in data) || isBoundedString(data.address, 300)) &&
        (!('city' in data) || isBoundedString(data.city, 80)) &&
        (!('country' in data) || isBoundedString(data.country, 80)) &&
        (!('mapUrl' in data) || isBoundedString(data.mapUrl, 300)) &&
        (!('customerType' in data) || data.customerType in ['individual', 'company', 'VIP', 'wholesale', 'retail']) &&
        (!('taxNumber' in data) || isBoundedString(data.taxNumber, 64)) &&
        (!('nationalId' in data) || isBoundedString(data.nationalId, 64)) &&
        (!('birthDate' in data) || isBoundedString(data.birthDate, 32)) &&
        (!('creditTermDays' in data) || (data.creditTermDays is number && data.creditTermDays >= 0)) &&
        (!('preferredPaymentMethod' in data) || isValidPaymentMethod(data.preferredPaymentMethod)) &&
        (!('salesRep' in data) || isBoundedString(data.salesRep, 120)) &&
        (!('branchId' in data) || isBoundedString(data.branchId, 128)) &&
        (!('status' in data) || data.status in ['active', 'paused', 'blocked']) &&
        (!('notes' in data) || isBoundedString(data.notes, 500)) &&
        (!('callLogs' in data) || isBoundedString(data.callLogs, 1000)) &&
        (!('createdAtDate' in data) || isBoundedString(data.createdAtDate, 64)) &&
        (!('createdBy' in data) || isBoundedString(data.createdBy, 120)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'phone', 'category', 'payable', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'name', 'phone', 'category', 'payable',
          'code', 'companyName', 'photoBase64', 'whatsapp', 'email', 'address', 'city', 'country',
          'supplierType', 'taxNumber', 'crNumber', 'bankAccount', 'bankName', 'creditLimit',
          'paymentTermDays', 'preferredPaymentMethod', 'branchId', 'repName', 'status',
          'notes', 'contractsNotes', 'createdAtDate', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.name, 160) &&
        isBoundedString(data.phone, 40) &&
        isBoundedString(data.category, 100) &&
        data.payable is number && data.payable >= 0 &&
        (!('code' in data) || isBoundedString(data.code, 64)) &&
        (!('companyName' in data) || isBoundedString(data.companyName, 160)) &&
        (!('photoBase64' in data) || isBoundedString(data.photoBase64, 250000)) &&
        (!('whatsapp' in data) || isBoundedString(data.whatsapp, 40)) &&
        (!('email' in data) || isBoundedString(data.email, 160)) &&
        (!('address' in data) || isBoundedString(data.address, 300)) &&
        (!('city' in data) || isBoundedString(data.city, 80)) &&
        (!('country' in data) || isBoundedString(data.country, 80)) &&
        (!('supplierType' in data) || data.supplierType in ['primary', 'secondary', 'manufacturer', 'importer']) &&
        (!('taxNumber' in data) || isBoundedString(data.taxNumber, 64)) &&
        (!('crNumber' in data) || isBoundedString(data.crNumber, 64)) &&
        (!('bankAccount' in data) || isBoundedString(data.bankAccount, 80)) &&
        (!('bankName' in data) || isBoundedString(data.bankName, 120)) &&
        (!('creditLimit' in data) || (data.creditLimit is number && data.creditLimit >= 0)) &&
        (!('paymentTermDays' in data) || (data.paymentTermDays is number && data.paymentTermDays >= 0)) &&
        (!('preferredPaymentMethod' in data) || isValidPaymentMethod(data.preferredPaymentMethod)) &&
        (!('branchId' in data) || isBoundedString(data.branchId, 128)) &&
        (!('repName' in data) || isBoundedString(data.repName, 120)) &&
        (!('status' in data) || data.status in ['active', 'paused', 'blocked']) &&
        (!('notes' in data) || isBoundedString(data.notes, 500)) &&
        (!('contractsNotes' in data) || isBoundedString(data.contractsNotes, 500)) &&
        (!('createdAtDate' in data) || isBoundedString(data.createdAtDate, 64)) &&
        (!('createdBy' in data) || isBoundedString(data.createdBy, 120)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPurchaseOrder(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'supplierId', 'supplierName', 'supplierPhone', 'productId',
          'productName', 'quantity', 'unitCost', 'subtotal', 'taxRate', 'vat', 'total',
          'status', 'date', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'supplierId', 'supplierName', 'supplierPhone', 'productId',
          'productName', 'quantity', 'unitCost', 'subtotal', 'taxRate', 'vat', 'total',
          'status', 'date', 'branchId', 'warehouseId', 'paymentMethod', 'notes', 'paidAmount',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isBoundedString(data.supplierId, 128) &&
        isNonEmptyString(data.supplierName, 160) &&
        isBoundedString(data.supplierPhone, 40) &&
        isBoundedString(data.productId, 128) &&
        isNonEmptyString(data.productName, 160) &&
        data.quantity is number && data.quantity >= 0 &&
        data.unitCost is number && data.unitCost >= 0 &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100 &&
        data.vat is number && data.vat >= 0 &&
        data.total is number && data.total >= 0 &&
        data.status in ['ordered', 'received'] &&
        isNonEmptyString(data.date, 64) &&
        (!('branchId' in data) || isBoundedString(data.branchId, 128)) &&
        (!('warehouseId' in data) || isBoundedString(data.warehouseId, 128)) &&
        (!('paymentMethod' in data) || isValidPaymentMethod(data.paymentMethod)) &&
        (!('notes' in data) || isBoundedString(data.notes, 500)) &&
        (!('paidAmount' in data) || (data.paidAmount is number && data.paidAmount >= 0)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVoucher(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'type', 'partyName', 'partyPhone', 'amount', 'reason',
          'paymentMethod', 'date', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'type', 'partyName', 'partyPhone', 'amount', 'reason',
          'paymentMethod', 'date', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        data.type in ['receipt', 'payment'] &&
        isNonEmptyString(data.partyName, 160) &&
        isBoundedString(data.partyPhone, 40) &&
        data.amount is number && data.amount >= 0 &&
        isBoundedString(data.reason, 400) &&
        isBoundedString(data.paymentMethod, 80) &&
        isNonEmptyString(data.date, 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidJournalEntry(data) {
      return data.keys().hasAll(['id', 'ownerId', 'reference', 'description', 'date', 'lines', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'reference', 'description', 'date', 'lines', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isBoundedString(data.reference, 120) &&
        isNonEmptyString(data.description, 400) &&
        isNonEmptyString(data.date, 64) &&
        isValidJournalLines(data.lines) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'sku', 'barcode', 'qty', 'cost', 'price', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'name', 'sku', 'barcode', 'imageBase64', 'qty', 'cost', 'price',
          'category', 'unit', 'wholesalePrice', 'taxRate', 'minStock', 'maxStock',
          'expiryDate', 'supplierId', 'warehouseId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.name, 160) &&
        isBoundedString(data.sku, 64) &&
        isBoundedString(data.barcode, 64) &&
        (!('imageBase64' in data) || isBoundedString(data.imageBase64, 250000)) &&
        data.qty is number && data.qty >= 0 &&
        data.cost is number && data.cost >= 0 &&
        data.price is number && data.price >= 0 &&
        (!('category' in data) || isBoundedString(data.category, 80)) &&
        (!('unit' in data) || data.unit in ['piece', 'carton', 'kg', 'meter']) &&
        (!('wholesalePrice' in data) || (data.wholesalePrice is number && data.wholesalePrice >= 0)) &&
        (!('taxRate' in data) || (data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100)) &&
        (!('minStock' in data) || (data.minStock is number && data.minStock >= 0)) &&
        (!('maxStock' in data) || (data.maxStock is number && data.maxStock >= 0)) &&
        (!('expiryDate' in data) || isBoundedString(data.expiryDate, 32)) &&
        (!('supplierId' in data) || isBoundedString(data.supplierId, 128)) &&
        (!('warehouseId' in data) || isBoundedString(data.warehouseId, 128)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'roleTitle', 'role', 'permissions', 'phone',
          'salary', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'name', 'roleTitle', 'role', 'permissions', 'phone',
          'salary', 'lastPaidDate', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.name, 160) &&
        isBoundedString(data.roleTitle, 100) &&
        isValidRoleId(data.role) &&
        isValidRoleList(data.permissions) &&
        isBoundedString(data.phone, 40) &&
        data.salary is number && data.salary >= 0 &&
        (!('lastPaidDate' in data) || isBoundedString(data.lastPaidDate, 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'category', 'amount', 'paidFromBankId', 'date', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'category', 'amount', 'paidFromBankId', 'date', 'branchId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.title, 160) &&
        isBoundedString(data.category, 80) &&
        data.amount is number && data.amount >= 0 &&
        isBoundedString(data.paidFromBankId, 128) &&
        isNonEmptyString(data.date, 64) &&
        (!('branchId' in data) || isBoundedString(data.branchId, 128)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBankAccount(data) {
      return data.keys().hasAll(['id', 'ownerId', 'nameAr', 'nameEn', 'accountNumber', 'balance', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'nameAr', 'nameEn', 'accountNumber', 'balance', 'lastReconciledDate', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.nameAr, 120) &&
        isNonEmptyString(data.nameEn, 120) &&
        isBoundedString(data.accountNumber, 64) &&
        data.balance is number &&
        (!('lastReconciledDate' in data) || isBoundedString(data.lastReconciledDate, 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRecurringInvoice(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'customerId', 'customerName', 'customerPhone', 'description',
          'items', 'subtotal', 'taxRate', 'currency', 'frequency', 'nextRunDate',
          'targetStatus', 'autoGenerate', 'active', 'generatedCount', 'notes', 'date',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'customerId', 'customerName', 'customerPhone', 'description',
          'items', 'subtotal', 'taxRate', 'currency', 'frequency', 'nextRunDate', 'lastGeneratedDate',
          'targetStatus', 'autoGenerate', 'active', 'generatedCount', 'notes', 'date',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isBoundedString(data.customerId, 128) &&
        isNonEmptyString(data.customerName, 160) &&
        isBoundedString(data.customerPhone, 40) &&
        isBoundedString(data.description, 500) &&
        isValidLineItems(data.items, 0, 50) &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100 &&
        isValidCurrencyCode(data.currency) &&
        data.frequency in ['weekly', 'monthly', 'quarterly', 'yearly'] &&
        isNonEmptyString(data.nextRunDate, 64) &&
        (!('lastGeneratedDate' in data) || isBoundedString(data.lastGeneratedDate, 64)) &&
        data.targetStatus in ['paid', 'partial', 'pending', 'overdue', 'cancelled'] &&
        data.autoGenerate is bool &&
        data.active is bool &&
        data.generatedCount is number && data.generatedCount >= 0 &&
        isBoundedString(data.notes, 500) &&
        isNonEmptyString(data.date, 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidArchivedDocument(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'docType', 'partyName', 'referenceId',
          'fileName', 'fileType', 'fileSizeBytes', 'notes', 'date', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'title', 'docType', 'partyName', 'referenceId',
          'fileName', 'fileType', 'fileSizeBytes', 'fileDataBase64', 'notes', 'date',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.title, 160) &&
        data.docType in ['contract', 'receipt', 'tax_cert', 'id_doc', 'invoice_scan', 'other'] &&
        isBoundedString(data.partyName, 160) &&
        isBoundedString(data.referenceId, 128) &&
        isBoundedString(data.fileName, 200) &&
        isBoundedString(data.fileType, 120) &&
        data.fileSizeBytes is number && data.fileSizeBytes >= 0 &&
        (!('fileDataBase64' in data) || isBoundedString(data.fileDataBase64, 250000)) &&
        isBoundedString(data.notes, 500) &&
        isNonEmptyString(data.date, 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBranch(data) {
      return data.keys().hasAll(['id', 'ownerId', 'nameAr', 'nameEn', 'city', 'phone', 'managerName', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'nameAr', 'nameEn', 'city', 'phone', 'managerName', 'isMain', 'active', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.nameAr, 120) &&
        isNonEmptyString(data.nameEn, 120) &&
        isBoundedString(data.city, 80) &&
        isBoundedString(data.phone, 40) &&
        isBoundedString(data.managerName, 120) &&
        (!('isMain' in data) || data.isMain is bool) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWarehouse(data) {
      return data.keys().hasAll(['id', 'ownerId', 'nameAr', 'nameEn', 'branchId', 'location', 'managerName', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'nameAr', 'nameEn', 'branchId', 'location', 'managerName', 'active', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.nameAr, 120) &&
        isNonEmptyString(data.nameEn, 120) &&
        isBoundedString(data.branchId, 128) &&
        isBoundedString(data.location, 160) &&
        isBoundedString(data.managerName, 120) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChartAccount(data) {
      return data.keys().hasAll(['id', 'ownerId', 'code', 'nameAr', 'nameEn', 'category', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'code', 'nameAr', 'nameEn', 'category', 'parentCode', 'isSystem', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.code, 32) &&
        isNonEmptyString(data.nameAr, 160) &&
        isNonEmptyString(data.nameEn, 160) &&
        data.category in ['assets', 'liabilities', 'equity', 'revenue', 'expenses'] &&
        (!('parentCode' in data) || isBoundedString(data.parentCode, 32)) &&
        (!('isSystem' in data) || data.isSystem is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStockMovement(data) {
      return data.keys().hasAll(['id', 'ownerId', 'productId', 'productName', 'movementType', 'qtyDelta', 'referenceId', 'notes', 'date', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'productId', 'productName', 'movementType', 'qtyDelta', 'fromWarehouseId', 'toWarehouseId', 'referenceId', 'notes', 'date', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isBoundedString(data.productId, 128) &&
        isNonEmptyString(data.productName, 160) &&
        data.movementType in ['sale', 'purchase', 'return_in', 'return_out', 'transfer', 'stocktake'] &&
        data.qtyDelta is number &&
        (!('fromWarehouseId' in data) || isBoundedString(data.fromWarehouseId, 128)) &&
        (!('toWarehouseId' in data) || isBoundedString(data.toWarehouseId, 128)) &&
        isBoundedString(data.referenceId, 128) &&
        isBoundedString(data.notes, 400) &&
        isNonEmptyString(data.date, 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStocktake(data) {
      return data.keys().hasAll(['id', 'ownerId', 'warehouseId', 'warehouseName', 'productId', 'productName', 'systemQty', 'actualQty', 'varianceQty', 'varianceValue', 'notes', 'date', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'warehouseId', 'warehouseName', 'productId', 'productName', 'systemQty', 'actualQty', 'varianceQty', 'varianceValue', 'notes', 'date', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isBoundedString(data.warehouseId, 128) &&
        isBoundedString(data.warehouseName, 120) &&
        isBoundedString(data.productId, 128) &&
        isNonEmptyString(data.productName, 160) &&
        data.systemQty is number && data.systemQty >= 0 &&
        data.actualQty is number && data.actualQty >= 0 &&
        data.varianceQty is number &&
        data.varianceValue is number &&
        isBoundedString(data.notes, 400) &&
        isNonEmptyString(data.date, 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLogEntry(data) {
      return data.keys().hasAll(['id', 'ownerId', 'actor', 'actorRole', 'action', 'entity', 'entityId', 'summary', 'timestamp', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'actor', 'actorRole', 'action', 'entity', 'entityId', 'summary', 'timestamp', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.actor, 160) &&
        isValidRoleId(data.actorRole) &&
        data.action in ['create', 'update', 'delete', 'pay', 'receive', 'transfer', 'reconcile', 'stocktake', 'fiscal_lock', 'backup'] &&
        isNonEmptyString(data.entity, 80) &&
        isBoundedString(data.entityId, 128) &&
        isNonEmptyString(data.summary, 400) &&
        isNonEmptyString(data.timestamp, 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudBackup(data) {
      return data.keys().hasAll(['id', 'ownerId', 'dateKey', 'recordCount', 'sizeBytes', 'payloadJson', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'dateKey', 'recordCount', 'sizeBytes', 'payloadJson', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        (data.ownerId == request.auth.uid || isAdmin()) &&
        isNonEmptyString(data.dateKey, 32) &&
        data.recordCount is number && data.recordCount >= 0 &&
        data.sizeBytes is number && data.sizeBytes >= 0 &&
        isNonEmptyString(data.payloadJson, 850000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // Production Collection Match Blocks
    // =========================================================================

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        hasValidTimestampsCreate(incoming()) &&
        incoming().role == 'user';
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        hasValidTimestampsUpdate() && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidWorkspace(incoming()) &&
        hasValidTimestampsCreate(incoming()) &&
        (incoming().ownerId == request.auth.uid || isAdmin());
      allow update: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidWorkspace(incoming()) &&
        hasValidTimestampsUpdate() &&
        incoming().ownerId == existing().ownerId && (
          isAdmin() || (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'companyName', 'taxNumber', 'crNumber', 'phone', 'email', 'address',
              'currency', 'enabledCurrencies', 'exchangeRates', 'lastRatesUpdate',
              'isArabic', 'isDarkMode', 'monthlySalesGoal',
              'defaultSalesTaxRate', 'defaultPurchaseTaxRate', 'autoBackupDaily',
              'lastBackupDate', 'autoCloudSync', 'autoSyncIntervalMinutes',
              'logoBase64', 'fiscalLockDate', 'defaultBranchId', 'defaultWarehouseId', 'receiptFooter',
              'activePlan', 'trialStartIso', 'currentRole', 'permissionsMatrix', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(workspaceId) && (existing().ownerId == request.auth.uid || isAdmin());

      match /invoices/{invoiceId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(invoiceId) && (isWorkspaceOwner(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(invoiceId) &&
          isValidInvoice(incoming()) &&
          hasValidTimestampsCreate(incoming()) &&
          incoming().id == invoiceId &&
          (isWorkspaceOwner(workspaceId) || isAdmin());
        allow update: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(invoiceId) &&
          isValidInvoice(incoming()) &&
          hasValidTimestampsUpdate() &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          (isWorkspaceOwner(workspaceId) || isAdmin()) &&
          (existing().status != 'paid' || isAdmin()) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'customerId', 'customerName', 'customerPhone', 'description',
              'items', 'subtotal', 'taxRate', 'vat', 'total', 'currency', 'exchangeRate', 'baseTotal',
              'status', 'date', 'invoiceType', 'dueDate', 'branchId', 'branchName', 'warehouseId',
              'warehouseName', 'salespersonName', 'shiftName', 'paymentMethod', 'discountTotal',
              'shippingFee', 'extraFee', 'paidAmount', 'remainingAmount', 'notes', 'terms',
              'sellerSignature', 'customerSignature', 'installments', 'createdByRole', 'updatedAt'
            ])
          );
        allow delete: if isVerifiedUser() && isValidId(workspaceId) && isValidId(invoiceId) && (isWorkspaceOwner(workspaceId) || isAdmin());
      }

      match /returns/{returnId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(returnId) && (isWorkspaceOwner(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(returnId) &&
          isValidReturnRecord(incoming()) &&
          hasValidTimestampsCreate(incoming()) &&
          incoming().id == returnId &&
          (isWorkspaceOwner(workspaceId) || isAdmin());
        allow update: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(returnId) &&
          isValidReturnRecord(incoming()) &&
          hasValidTimestampsUpdate() &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          (isWorkspaceOwner(workspaceId) || isAdmin()) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'type', 'originalDocId', 'partyName', 'partyPhone', 'productId',
              'productName', 'qty', 'unitPrice', 'amount', 'reason', 'notes', 'date', 'updatedAt'
            ])
          );
        allow delete: if isVerifiedUser() && isValidId(workspaceId) && isValidId(returnId) && (isWorkspaceOwner(workspaceId) || isAdmin());
      }

      match /quotations/{quotationId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(quotationId) && (isWorkspaceOwner(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(quotationId) &&
          isValidQuotation(incoming()) &&
          hasValidTimestampsCreate(incoming()) &&
          incoming().id == quotationId &&
          (isWorkspaceOwner(workspaceId) || isAdmin());
        allow update: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(quotationId) &&
          isValidQuotation(incoming()) &&
          hasValidTimestampsUpdate() &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          (isWorkspaceOwner(workspaceId) || isAdmin()) &&
          (!(existing().status in ['accepted', 'rejected']) || isAdmin()) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'customerId', 'customerName', 'customerPhone', 'customerEmail', 'items',
              'discountPercent', 'subtotal', 'discountAmount', 'vat', 'total',
              'validUntil', 'status', 'notes', 'date', 'updatedAt'
            ])
          );
        allow delete: if isVerifiedUser() && isValidId(workspaceId) && isValidId(quotationId) && (isWorkspaceOwner(workspaceId) || isAdmin());
      }

      match /customers/{customerId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(customerId) && (isWorkspaceOwner(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(customerId) &&
          isValidCustomer(incoming()) &&
          hasValidTimestampsCreate(incoming()) &&
          incoming().id == customerId &&
          (isWorkspaceOwner(workspaceId) || isAdmin());
        allow update: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(customerId) &&
          isValidCustomer(incoming()) &&
          hasValidTimestampsUpdate() &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          (isWorkspaceOwner(workspaceId) || isAdmin()) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'email', 'debt', 'creditLimit',
              'code', 'companyName', 'photoBase64', 'whatsapp', 'address', 'city', 'country',
              'mapUrl', 'customerType', 'taxNumber', 'nationalId', 'birthDate', 'creditTermDays',
              'preferredPaymentMethod', 'salesRep', 'branchId', 'status', 'notes', 'callLogs',
              'createdAtDate', 'createdBy', 'updatedAt'
            ])
          );
        allow delete: if isVerifiedUser() && isValidId(workspaceId) && isValidId(customerId) && (isWorkspaceOwner(workspaceId) || isAdmin());
      }

      match /suppliers/{supplierId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(supplierId) && (isWorkspaceOwner(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(supplierId) &&
          isValidSupplier(incoming()) &&
          hasValidTimestampsCreate(incoming()) &&
          incoming().id == supplierId &&
          (isWorkspaceOwner(workspaceId) || isAdmin());
        allow update: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(supplierId) &&
          isValidSupplier(incoming()) &&
          hasValidTimestampsUpdate() &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          (isWorkspaceOwner(workspaceId) || isAdmin()) && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'category', 'payable',
              'code', 'companyName', 'photoBase64', 'whatsapp', 'email', 'address', 'city', 'country',
              'supplierType', 'taxNumber', 'crNumber', 'bankAccount', 'bankName', 'creditLimit',
              'paymentTermDays', 'preferredPaymentMethod', 'branchId', 'repName', 'status',
              'notes', 'contractsNotes', 'createdAtDate', 'createdBy', 'updatedAt'
            ])
          );
        allow delete: if isVerifiedUser() && isValidId(workspaceId) && isValidId(supplierId) && (isWorkspaceOwner(workspaceId) || isAdmin());
      }

      match /purchaseOrders/{poId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(poId) && (isWorkspaceOwner(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(poId) &&
          isValidPurchaseOrder(incoming()) &&
